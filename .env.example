# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ENVIRONMENT=production

# Database (PostgreSQL on Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/degaan_db
POSTGRES_DB=degaan_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend URL
FRONTEND_URL=https://degaanrealestate.com

# CORS
CORS_ALLOWED_ORIGINS=https://degaanrealestate.com,https://www.degaanrealestate.com

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@degaanrealestate.com

# Site URL for admin links
SITE_URL=https://degaanrealestate.com
