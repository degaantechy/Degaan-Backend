# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.up.railway.app

# Leave blank for local SQLite. Railway supplies this when PostgreSQL is linked.
DATABASE_URL=

# Frontend URL
FRONTEND_URL=https://degaanrealestate.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://degaanrealestate.com,https://www.degaanrealestate.com

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@degaanrealestate.com

# Site URL for admin links
SITE_URL=https://degaanrealestate.com
